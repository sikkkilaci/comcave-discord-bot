// Prisma-Schema fuer den COMCAVE Discord Bot.
//
// Bewusst als Grundgeruest angelegt: die Modelle bilden die Datenstruktur ab,
// die fuer die geplanten Kernfunktionen (Verifizierung, Onboarding, Klassen,
// Klassenleitung, Berichte, Moderation, Logging) benoetigt wird. Die dazugehoerige
// Business-Logik wird schrittweise in spaeteren Iterationen ergaenzt.
//
// Datenbank: SQLite (ausreichend fuer eine private Lerngruppe, keine externe
// Infrastruktur noetig). Bei Bedarf spaeter per `provider` auf Postgres wechselbar.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Konfiguration pro Discord-Server (Bot kann grundsaetzlich auf mehreren
/// Servern laufen, primaerer Einsatz ist aber ein einzelner privater Server).
model GuildConfig {
  id        String   @id // Discord Guild-ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Rollen-IDs fuer das Berechtigungssystem (siehe src/permissions).
  adminRoleId     String?
  moderatorRoleId String?
  verifiedRoleId  String?

  // Kanal-IDs fuer wiederkehrende Bot-Ausgaben.
  logChannelId      String?
  welcomeChannelId  String?
  whereAmIChannelId String? // #wo-bin-ich

  classes                     Class[]
  members                     Member[]
  auditLogs                   AuditLogEntry[]
  exams                       Exam[]
  appointments                Appointment[]
  dailyReports                DailyReport[]
  weeklyReports               WeeklyReport[]
  learningMaterials           LearningMaterial[]
  courseEntries               CourseEntry[]
  courseSpecialDays           CourseSpecialDay[]
  courseAcknowledgments       CourseAcknowledgment[]
  courseUpcomingNotifications CourseUpcomingNotification[]
  studyGroups                 StudyGroup[]
  studyGroupMembers           StudyGroupMember[]
}

/// Ein Mitglied der Lerngruppe, verknuepft mit seinem Discord-Account.
model Member {
  id        String      @id @default(cuid())
  guildId   String
  guild     GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)
  discordId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Verifizierung / Onboarding.
  // SQLite kennt keine nativen Enums, daher String mit Validierung in der
  // Anwendungsschicht (siehe src/types/domain.ts): "PENDING" | "VERIFIED" | "REJECTED".
  verificationStatus String             @default("PENDING")
  verifiedAt         DateTime?
  onboardingAnswers  OnboardingAnswer[]

  // Erfassung IT-Erfahrung/Interessen aus dem Onboarding.
  // Erlaubte Werte (siehe src/types/domain.ts): "KEINE" | "ANFAENGER" | "FORTGESCHRITTEN" | "ERFAHREN".
  itExperienceLevel String?
  interests         String? // JSON-kodierte Liste, bis ein dediziertes Interest-Modell noetig ist

  // Klassenzuweisung.
  classId String?
  class   Class?  @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@unique([guildId, discordId])
  @@index([classId])
}

/// Antwort auf eine (ggf. dynamisch gestellte) Onboarding-Frage.
model OnboardingAnswer {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  createdAt DateTime @default(now())

  @@index([memberId])
}

/// Eine Klasse (A/B/C). Klassenleitung erhaelt ueber `leadRoleId` administrative
/// Rechte, die per Permission-System auf genau diese Klasse beschraenkt werden.
model Class {
  id      String      @id @default(cuid())
  guildId String
  guild   GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)

  name       String // z. B. "A", "B", "C"
  roleId     String? // Discord-Rolle, die Mitglieder dieser Klasse erhalten
  categoryId String? // Discord-Kategorie fuer den privaten Klassenbereich
  leadRoleId String? // Rolle der Klassenleitung fuer diese Klasse

  // Discord-ID der Person, die aktuell als Klassenleitung zugewiesen ist (falls
  // vorhanden). Separat von leadRoleId, damit bei einer Neuzuweisung/Entfernung
  // gezielt genau dieser Person die Rolle wieder entzogen werden kann, auch wenn
  // sie z. B. gerade nicht im Guild-Cache ist. `null` bedeutet: Rolle existiert
  // ggf. bereits (leadRoleId gesetzt), aber aktuell niemandem zugewiesen.
  leadDiscordId String?

  // Kanal-IDs innerhalb des privaten Klassenbereichs (siehe classAreaService.ts).
  // Explizit persistiert statt per Namenssuche wiedergefunden, damit spaetere
  // Features (z. B. Berichtsheft, Termine) zuverlaessig auf den richtigen
  // Kanal verweisen koennen, auch wenn er umbenannt wird.
  chatChannelId         String? // Klassenchat
  announcementChannelId String? // Ankuendigungen (read-only fuer die Klasse)
  scheduleChannelId     String? // Termine
  examChannelId         String? // Pruefungen
  reportChannelId       String? // Berichtsheft / Tagesberichte
  materialChannelId     String? // Lernmaterial
  voiceChannelId        String? // Klassen-Sprachkanal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members                     Member[]
  exams                       Exam[]
  appointments                Appointment[]
  dailyReports                DailyReport[]
  weeklyReports               WeeklyReport[]
  learningMaterials           LearningMaterial[]
  courseEntries               CourseEntry[]
  courseSpecialDays           CourseSpecialDay[]
  courseAcknowledgments       CourseAcknowledgment[]
  courseUpcomingNotifications CourseUpcomingNotification[]
  studyGroups                 StudyGroup[]
  studyGroupMembers           StudyGroupMember[]

  @@unique([guildId, name])
  @@index([guildId, leadDiscordId])
}

/// Pruefung einer Klasse (Fach/Thema, Beschreibung, optionale Lernhinweise,
/// Datum+Uhrzeit). Verwaltet ausschliesslich von Admin oder der Klassenleitung
/// genau dieser Klasse (siehe examService.ts).
model Exam {
  id      String      @id @default(cuid())
  guildId String
  guild   GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)
  classId String
  class   Class       @relation(fields: [classId], references: [id], onDelete: Cascade)

  subject     String // Fach/Thema
  description String
  studyNotes  String? // optionale Lernhinweise
  scheduledAt DateTime // Datum + Uhrzeit der Pruefung

  createdByDiscordId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, classId, scheduledAt])
}

/// Termin einer Klasse (Titel, Beschreibung, Datum+Uhrzeit). Verwaltet
/// ausschliesslich von Admin oder der Klassenleitung genau dieser Klasse
/// (siehe appointmentService.ts).
model Appointment {
  id      String      @id @default(cuid())
  guildId String
  guild   GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)
  classId String
  class   Class       @relation(fields: [classId], references: [id], onDelete: Cascade)

  title       String
  description String
  scheduledAt DateTime

  createdByDiscordId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, classId, scheduledAt])
}

/// Tagesbericht einer Klasse (Berichtsheft-Grundlage). Verwaltet ausschliesslich
/// von Admin oder der Klassenleitung genau dieser Klasse (siehe dailyReportService.ts).
model DailyReport {
  id      String      @id @default(cuid())
  guildId String
  guild   GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)
  classId String
  class   Class       @relation(fields: [classId], references: [id], onDelete: Cascade)

  date             DateTime // Datum des Tagesberichts
  topics           String // behandelte Themen
  content          String // Lerninhalte
  notes            String // besondere Hinweise
  relatedMaterials String? // optional verknuepfte Lernmaterialien (Freitext-Referenz)

  createdByDiscordId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, classId, date])
}

/// Wochenbericht einer Klasse (Berichtsheft-Grundlage). Verwaltet ausschliesslich
/// von Admin oder der Klassenleitung genau dieser Klasse (siehe weeklyReportService.ts).
model WeeklyReport {
  id      String      @id @default(cuid())
  guildId String
  guild   GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)
  classId String
  class   Class       @relation(fields: [classId], references: [id], onDelete: Cascade)

  year         Int // Jahr der Kalenderwoche (aus periodStart abgeleitet, fuer eindeutige Sortierung/Abfrage)
  calendarWeek Int // Kalenderwoche (1-53)
  periodStart  DateTime // Zeitraum: Beginn
  periodEnd    DateTime // Zeitraum: Ende
  topics       String // behandelte Themen
  progress     String // Lernfortschritt / Inhalte
  notes        String // besondere Hinweise

  createdByDiscordId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, classId, year, calendarWeek])
}

/// Lernmaterial einer Klasse (Titel, Beschreibung, Fach/Thema, Kategorie,
/// optional URL/Discord-Anhang, optional Verknuepfung mit einer Pruefung oder
/// einem Bericht DERSELBEN Klasse). Verwaltet ausschliesslich von Admin oder
/// der Klassenleitung genau dieser Klasse (siehe learningMaterialService.ts).
model LearningMaterial {
  id      String      @id @default(cuid())
  guildId String
  guild   GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)
  classId String
  class   Class       @relation(fields: [classId], references: [id], onDelete: Cascade)

  title       String
  description String
  subject     String // Fach/Thema
  category    String // siehe LEARNING_MATERIAL_CATEGORIES in src/types/domain.ts

  url String? // optionaler externer Link

  // Optionale Discord-Anhang-Metadaten - der Anhang selbst bleibt auf Discords
  // CDN, hier wird nur der Verweis gespeichert (siehe ARCHITECTURE.md).
  attachmentUrl         String?
  attachmentName        String?
  attachmentContentType String?

  // Optionale Verknuepfung mit einer Pruefung/einem Bericht DERSELBEN Klasse.
  // Bewusst kein DB-Fremdschluessel (waere polymorph auf drei verschiedene
  // Zieltabellen) - Existenz und Klassenzugehoerigkeit werden stattdessen
  // serverseitig im Service geprueft (siehe learningMaterialService.ts).
  linkedType String? // "EXAM" | "DAILY_REPORT" | "WEEKLY_REPORT", siehe src/types/domain.ts
  linkedId   String?

  createdByDiscordId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, classId, category])
}

/// Zentrales Audit-Log fuer administrative Aktionen und Moderation.
model AuditLogEntry {
  id      String      @id @default(cuid())
  guildId String
  guild   GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)

  actorDiscordId  String // wer hat die Aktion ausgefuehrt
  action          String // z. B. "member.verify", "class.assign", "moderation.mute"
  targetDiscordId String? // betroffenes Mitglied, falls zutreffend
  metadata        String? // JSON-kodierte Zusatzinfos
  createdAt       DateTime @default(now())

  @@index([guildId, createdAt])
}

/// Ein Kurs-Slot im Kursplan einer Klasse, aus einer versionierten Quelldatei
/// importiert (siehe src/services/coursePlanImportService.ts). Bewusst
/// klassen-/guild-gescoped wie jede andere Fachfunktion in diesem Schema,
/// damit spaeter auch Klasse B/C eigene Eintraege bekommen koennen, ohne
/// dieses Modell aendern zu muessen - `classId` entscheidet allein, zu
/// welcher Klasse ein Kurs gehoert.
model CourseEntry {
  id      String      @id @default(cuid())
  guildId String
  guild   GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)
  classId String
  class   Class       @relation(fields: [classId], references: [id], onDelete: Cascade)

  courseNumber String // Kursnummer aus der Quelle, z. B. "567469"
  title        String // Kurstitel/Thema
  trainer      String? // Dozent, falls in der Quelle angegeben (leerer String -> null)
  startDate    DateTime // Beginn (Datumsgranularitaet, UTC-Mitternacht)
  endDate      DateTime // Ende (Datumsgranularitaet, UTC-Mitternacht)

  sourceFile         String // Pfad der versionierten Quelldatei, fuer Nachvollziehbarkeit
  createdByDiscordId String // wer den Import ausgefuehrt hat

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  acknowledgments      CourseAcknowledgment[]
  upcomingNotification CourseUpcomingNotification?

  // Verhindert Duplikate bei wiederholtem Import: derselbe Kurs-Slot (Klasse +
  // Kursnummer + Start) wird beim erneuten Import erkannt und aktualisiert
  // statt neu angelegt (siehe upsertCourseEntry() in coursePlanRepository.ts).
  @@unique([classId, courseNumber, startDate])
  @@index([guildId, classId, startDate])
}

/// Unterrichtsfreier/besonderer Termin im Kursplan einer Klasse (Feiertag,
/// unterrichtsfreie Zeit) - analog zu CourseEntry klassen-/guild-gescoped und
/// ueber denselben Import-Weg befuellt.
model CourseSpecialDay {
  id      String      @id @default(cuid())
  guildId String
  guild   GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)
  classId String
  class   Class       @relation(fields: [classId], references: [id], onDelete: Cascade)

  label     String
  startDate DateTime
  endDate   DateTime

  sourceFile String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, startDate, endDate, label])
  @@index([guildId, classId, startDate])
}

/// Kenntnisnahme eines verifizierten Mitglieds fuer einen Kurs-Slot -
/// eindeutig pro Kurs+Mitglied (`@@unique`), ein erneuter Klick auf den
/// "Kenntnis genommen"-Button erzeugt daher nie einen zweiten Eintrag (siehe
/// acknowledgeCourseEntry() in coursePlanRepository.ts).
model CourseAcknowledgment {
  id            String      @id @default(cuid())
  guildId       String
  guild         GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)
  classId       String
  class         Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  courseEntryId String
  courseEntry   CourseEntry @relation(fields: [courseEntryId], references: [id], onDelete: Cascade)

  memberDiscordId String
  acknowledgedAt  DateTime @default(now())

  @@unique([courseEntryId, memberDiscordId])
  @@index([guildId, classId])
}

/// Merkt sich, dass fuer einen Kurs-Slot bereits die "startet in <= 7 Tagen"-
/// Benachrichtigung erzeugt wurde. `courseEntryId` ist `@unique` (nicht nur
/// `@@unique` mit weiteren Feldern), daher verhindert das Schema selbst -
/// unabhaengig von der Abfragelogik in coursePlanNotificationService.ts -
/// zuverlaessig doppelte Benachrichtigungen fuer denselben Kurs, auch bei
/// wiederholten Bot-Starts.
model CourseUpcomingNotification {
  id            String      @id @default(cuid())
  guildId       String
  guild         GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)
  classId       String
  class         Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  courseEntryId String      @unique
  courseEntry   CourseEntry @relation(fields: [courseEntryId], references: [id], onDelete: Cascade)

  notifiedAt DateTime @default(now())

  @@index([guildId, classId])
}

/// Temporaere, klassenbezogene Lern-/Arbeitsgruppe (nicht zu verwechseln mit der
/// "Lerngruppe" im Sinne der gesamten COMCAVE-Kohorte, siehe README/ARCHITECTURE.md
/// Einleitung) - Mitglieder einer Klasse koennen sich fuer gemeinsames Lernen zu
/// einer Gruppe zusammenschliessen. Guild-/klassen-gescoped wie jede andere
/// Fachfunktion; `classId` entscheidet allein ueber die Klassenzugehoerigkeit.
/// Nutzt bewusst KEINEN eigenen Voice-Kanal (siehe "Lern-/Arbeitsgruppen" in
/// ARCHITECTURE.md) - der Klassen-Sprachkanal (`Class.voiceChannelId`) steht
/// bereits allen Klassenmitgliedern offen, ein dynamisch angelegter/geloeschter
/// Voice-Kanal pro Gruppe waere unnoetige Komplexitaet (Kanal-Lifecycle,
/// verwaiste Kanaele bei Absturz, Discord-Kanal-Limits) ohne echten Mehrwert.
model StudyGroup {
  id      String      @id @default(cuid())
  guildId String
  guild   GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)
  classId String
  class   Class       @relation(fields: [classId], references: [id], onDelete: Cascade)

  name               String
  createdByDiscordId String

  // Status aktiv/inaktiv statt Loeschen, damit geschlossene Gruppen fuer
  // Audit/Nachvollziehbarkeit erhalten bleiben (dieselbe Ueberlegung wie bei
  // Klassenleitungs-Rollen, die beim Entfernen ebenfalls nicht geloescht werden).
  isActive          Boolean   @default(true)
  closedAt          DateTime?
  closedByDiscordId String?

  // Optionale Teilnehmerobergrenze - serverseitig in studyGroupService.ts
  // durchgesetzt, nicht nur als Anzeige-Information.
  maxParticipants Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members StudyGroupMember[]

  @@index([guildId, classId, isActive])
}

/// Mitgliedschaft eines Discord-Nutzers in einer Lerngruppe - eindeutig pro
/// Gruppe+Mitglied (`@@unique`), ein erneuter Beitritt erzeugt daher nie einen
/// zweiten Eintrag (siehe joinStudyGroup() in studyGroupService.ts).
model StudyGroupMember {
  id           String      @id @default(cuid())
  guildId      String
  guild        GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)
  classId      String
  class        Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  studyGroupId String
  studyGroup   StudyGroup  @relation(fields: [studyGroupId], references: [id], onDelete: Cascade)

  memberDiscordId String
  joinedAt        DateTime @default(now())

  @@unique([studyGroupId, memberDiscordId])
  @@index([guildId, classId])
}
