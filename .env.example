# Discord-Bot-Zugangsdaten
# NIEMALS echte Werte hier eintragen oder committen - nur als Vorlage fuer .env verwenden.
DISCORD_TOKEN=changeme
DISCORD_CLIENT_ID=changeme

# Optional: Guild-ID fuer schnelles Registrieren von Slash-Commands waehrend der Entwicklung.
# Wenn gesetzt, werden Commands nur auf diesem Server registriert (sofortige Verfuegbarkeit).
# Wenn leer, werden Commands global registriert (kann bis zu 1h dauern).
DISCORD_DEV_GUILD_ID=

# Rollen-ID der Server-Administration (volle Bot-Adminrechte). Optional in der Startphase.
DISCORD_OWNER_ROLE_ID=

# Umgebung: development | production
NODE_ENV=development

# Log-Level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Pfad zur SQLite-Datenbankdatei (Prisma-Connection-String-Format).
# Wichtig: relative Pfade werden von Prisma relativ zu prisma/schema.prisma aufgeloest,
# "file:./dev.db" ergibt also die Datei prisma/dev.db.
DATABASE_URL="file:./dev.db"
